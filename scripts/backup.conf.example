# 示例配置，不要将真实配置文件提交到源码仓库。
# 正常情况下由交互式管理器生成 /etc/vaultwarden-backup.conf。
CONTAINER="1Panel-bitwarden-example"
DATA_DIR="/opt/1panel/apps/bitwarden/bitwarden/data"
AGE_RECIPIENT="age1replace_with_your_public_recipient"
GITHUB_REPO="git@github.com:YOUR_USER/vaultwarden-backup.git"
GITHUB_BRANCH="main"
GITHUB_SSH_KEY="/root/.ssh/vw_github_backup"
BACKUP_DIR="/var/backups/vaultwarden"
REPO_DIR="/opt/vw-github-repo"
RETENTION_DAYS="30"
MAX_FILE_MIB="90"
BACKUP_TARGET="github"
PRIMARY_TARGET=""
SECONDARY_TARGET="none"
SNAPSHOT_MODE="stop"
UPDATE_CHANNEL="stable"
WEBDAV_RETENTION_DAYS="0"
WEBDAV_MIN_KEEP="7"
ALERT_MAX_BACKUP_AGE_HOURS=""
ALERT_MAX_DRILL_AGE_DAYS="90"
CONTAINER_MATCH=""
AGE_IDENTITY_DEFAULT="/root/vw-age-identity.txt"

# 自动化：每日 VPS 本地时间 05:20；由菜单 9 安装 systemd timer。
SYSTEMD_TIME="*-*-* 05:20:00"
BACKUP_FREQUENCY="daily"  # daily / weekly / monthly
MIN_FREE_MB="512"
GIT_PUSH_RETRIES="3"
GIT_RETRY_DELAY="15"

# 通知方式：none / telegram / ntfy / webhook。
NOTIFY_METHOD="none"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
NTFY_URL=""
NTFY_TOKEN=""
WEBHOOK_URL=""
NOTIFY_ON_SUCCESS="true"
NOTIFY_ON_FAILURE="true"

# WebDAV credentials are configured separately by menu 24 in /etc/vaultwarden-webdav.json.
# BACKUP_TARGET accepts github or webdav for scheduled backups.
